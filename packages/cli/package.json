{
  "name": "allure-kit",
  "version": "0.2.3",
  "description": "Standalone CLI toolkit for bootstrapping and maintaining an Allure 3 setup in JavaScript/TypeScript and Python projects",
  "keywords": [
    "allure",
    "allure3",
    "allurerc",
    "report",
    "reporter",
    "testing",
    "test-report",
    "cli",
    "scaffold",
    "setup",
    "bootstrap",
    "gh-pages"
  ],
  "license": "Apache-2.0",
  "author": "Todti <hellotodt@gmail.com>",
  "homepage": "https://github.com/todti/allure-kit#readme",
  "bugs": {
    "url": "https://github.com/todti/allure-kit/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/todti/allure-kit.git",
    "directory": "packages/cli"
  },
  "bin": {
    "allure-kit": "bin/allure-kit.js"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": ["dist", "bin"],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "prepublishOnly": "npm run build",
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "start": "node ./bin/allure-kit.js",
    "typecheck": "tsc -b tsconfig.json"
  },
  "dependencies": {
    "@todti/allure-kit-core": "^0.1.0",
    "@todti/allure-kit-npm": "^0.1.0",
    "@todti/allure-kit-python": "^0.1.0",
    "clipanion": "^4.0.0-rc.4",
    "prompts": "^2.4.2",
    "yoctocolors": "^2.1.1"
  }
}
